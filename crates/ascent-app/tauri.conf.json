{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ascent",
  "version": "0.6.0",
  "identifier": "app.ascent.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../app"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Ascent",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../docs/offline/*",
      "../../docs/VERIFY_RELEASE.md",
      "../../docs/EVIDENCE.md",
      "../../docs/CREDIBILITY.md",
      "../../docs/CROSS_VALIDATION.md",
      "../../docs/JOURNAL_FORMAT.md",
      "../../docs/EXPORTS.md",
      "../../docs/SIXDOF_DERIVATION.md"
    ],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Deterministic rocket design and flight review workbench",
    "longDescription": "Ascent is an offline, deterministic workbench for rocket design, simulation, dispersion studies, evidence, and flight-readiness review.",
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
